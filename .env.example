# Azure Key Vault (used by both CLI and web app)
KVP_VAULT_URL=https://your-vault-name.vault.azure.net

# Microsoft Entra ID app registration (used by the web app only)
KVP_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
KVP_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
KVP_ENTRA_CLIENT_SECRET=your-client-secret
KVP_ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback

# Web session cookie signing key (generate a long random string)
KVP_SESSION_SECRET=change-me-to-a-long-random-value

# Web bind address (default 0.0.0.0; set 127.0.0.1 for local-only, no firewall prompt)
KVP_BIND_ADDR=0.0.0.0

# Logging
KVP_LOG_LEVEL=INFO

# Local testing without Azure: set to 1 (uses ./kvp-mock-vault.json) or a file path.
# Enables a file-backed mock vault and, for the web app, a simulated dev sign-in.
# KVP_MOCK=1
